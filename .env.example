# Copy to .env and fill in as needed. The defaults run with no external services.
LLM_PROVIDER=mock

# Only needed once you switch LLM_PROVIDER to a real model (Phase 4).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres + pgvector (Phase 1).
DATABASE_URL=postgresql://finsight:finsight@db:5432/finsight
